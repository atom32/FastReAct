# FastReAct + GraphRAG 配置文件
# 复制此文件为 .env 并填入实际值

# ================================
# OpenAI API配置
# ================================
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4

# ================================
# GraphRAG配置
# ================================
# HippoRAG后端服务地址
HIPPO_RAG_URL=http://localhost:8080

# HippoRAG API密钥（可选）
HIPPO_RAG_API_KEY=

# HippoRAG请求超时（秒）
HIPPO_RAG_TIMEOUT=10

# ================================
# FastReAct配置
# ================================
# 最大迭代次数
MAX_ITERATIONS=10

# 是否启用缓存
ENABLE_CACHE=true

# 缓存大小
CACHE_SIZE=1000

# 是否启用流式输出
ENABLE_STREAMING=false

# 最大并发工具数
MAX_CONCURRENT_TOOLS=3

# ================================
# 日志配置
# ================================
# 日志级别: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# 日志文件路径（可选）
LOG_FILE=
