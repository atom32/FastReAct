# FastReAct service console environment.
#
# Values prefixed with NEXT_PUBLIC_ are visible to the browser. Do not put LLM
# API keys, PSKA service tokens, or long-lived production secrets here.

NEXT_PUBLIC_FASTREACT_SERVICE_HTTP_URL=http://127.0.0.1:8000

# Optional local convenience. Prefer pasting the service token into the console
# header on shared machines; it is stored in browser local storage.
NEXT_PUBLIC_FASTREACT_SERVICE_TOKEN=
