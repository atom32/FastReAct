# FastReAct Nano web environment
#
# Copy to .env.local for local development. Values prefixed with NEXT_PUBLIC_
# are visible to the browser, so do not put LLM API keys or PATs here.

NEXT_PUBLIC_FASTREACT_GATEWAY_HTTP_URL=http://localhost:9000
NEXT_PUBLIC_FASTREACT_GATEWAY_WS_URL=ws://localhost:9000

# Optional convenience for protected Admin APIs. Prefer entering this in the
# Config tab UI for shared machines.
NEXT_PUBLIC_FASTREACT_ADMIN_KEY=
