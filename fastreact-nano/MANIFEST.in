# FastReAct Nano - MANIFEST.in
# Include additional files in the Python package distribution

# Frontend assets (Vue 3 SPA)
include frontend/dist/index.html
include frontend/dist/vite.svg
recursive-include frontend/dist/assets *.js *.css *.map
recursive-include frontend/dist/assets *.woff *.woff2 *.ttf *.eot

# Documentation
include README.md
include LICENSE
include CHANGELOG.md
include CLAUDE.md
include DOCS_INDEX.md

# Example configs
include examples/*.py
include examples/*.yaml
include examples/*.json

# Data files
recursive-include src/fastreact/data *.json

# Type stubs
recursive-include src/fastreact *.pyi

# Exclude development files
exclude .gitignore
exclude .env.example
exclude .pre-commit-config.yaml
recursive-exclude * __pycache__
recursive-exclude * *.py[cod]
recursive-exclude * .DS_Store
recursive-exclude * *.so
recursive-exclude * .pytest_cache
recursive-exclude * .mypy_cache
recursive-exclude * .coverage
recursive-exclude * htmlcov
recursive-exclude * .tox
