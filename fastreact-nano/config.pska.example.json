{
  "_comment": "FastReAct Nano headless daemon preset for PSKA integration.",
  "llm": {
    "model": "deepseek-v4-flash",
    "api_base": "https://api.deepseek.com",
    "api_key_file": "~/api_key.txt",
    "temperature": 0.7,
    "max_tokens": 8192
  },
  "service": {
    "host": "127.0.0.1",
    "port": 18741,
    "log_level": "info",
    "service_token": "replace-with-local-service-token",
    "approval_timeout_seconds": 300,
    "run_lease_seconds": 300,
    "run_max_attempts": 3,
    "recover_queued_runs": true,
    "cors_origins": [
      "http://127.0.0.1:3000",
      "http://localhost:3000"
    ]
  },
  "web": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 3000
  },
  "logs": {
    "http": "/tmp/fastreact-http.log",
    "web": "/tmp/fastreact-web.log"
  },
  "pska": {
    "enabled": true,
    "archive": "/Users/xudawei/Documents/personal archive",
    "refresh_config": false,
    "config_file": null,
    "mcp_transport": "http"
  },
  "paths": {
    "workspaces_root": "~/FastReAct_workspaces",
    "gateway_workspace": "~/FastReAct_workspaces/single/pska"
  },
  "react": {
    "max_iterations": 128,
    "max_context_tokens": 128000,
    "sliding_window_size": 15,
    "max_tool_output_chars": 20000,
    "enable_safety": true,
    "auto_approve_safe": true,
    "enable_filesystem_memory": true
  },
  "extensions": {
    "runtime_reload_enabled": false,
    "mcp_reload_enabled": false
  },
  "mcp": {
    "servers": [
      {
        "name": "pska",
        "transport": "http",
        "url": "http://127.0.0.1:8765/mcp",
        "auth_token_ref": "mcp_api_keys.pska",
        "isolation": "shared",
        "identity_forwarding": {
          "mode": "authnode_jwt",
          "audience": "pska"
        },
        "description": "PSKA HTTP MCP endpoint."
      }
    ],
    "_fallback_stdio_mcp": {
      "name": "pska",
      "transport": "stdio",
      "command": "/Users/xudawei/Documents/personal archive/scripts/pska",
      "args": ["mcp-server"],
      "isolation": "shared",
      "identity_forwarding": {
        "mode": "service_token_params_dev",
        "audience": "pska",
        "stdio_dev_only": true
      },
      "description": "PSKA local stdio MCP fallback."
    }
  },
  "policy": {
    "default_action": "deny",
    "tool_rules": {
      "exec": "deny",
      "read_file": "deny",
      "write_file": "deny",
      "edit_file": "deny",
      "pska_pska_search": "allow",
      "pska_pska_index_status": "allow",
      "pska_pska_read_evidence_context": "allow",
      "pska_pska_graph_context": "allow",
      "pska_pska_digest_context": "allow",
      "pska_pska_job_context": "allow",
      "pska_pska_write_candidates": "allow",
      "pska_pska_ingest_channel_payload": "deny",
      "pska_pska_extract_all": "deny",
      "pska_pska_review_items": "deny"
    },
    "tool_profiles": {
      "pska_ask_read": {
        "description": "Read-only PSKA research tools for Ask deep mode.",
        "tools": [
          "pska_pska_search",
          "pska_pska_index_status",
          "pska_pska_read_evidence_context",
          "pska_pska_graph_context",
          "pska_pska_digest_context"
        ]
      },
      "pska_digest_worker": {
        "description": "PSKA digest worker tools for job-scoped candidate writing.",
        "tools": [
          "pska_pska_job_context",
          "pska_pska_write_candidates"
        ]
      },
      "coding_workspace": {
        "description": "Native coding tools; require a coding-agent profile and workspace path guard.",
        "tools": [
          "read_file",
          "write_file",
          "edit_file",
          "exec"
        ]
      }
    }
  }
}
