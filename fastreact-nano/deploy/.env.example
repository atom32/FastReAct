# FastReAct Nano Environment Configuration
# Copy this file to .env and fill in your values

# ==================================================
# LLM Configuration (Required)
# ==================================================
# Choose your LLM provider: openai, anthropic, deepseek, etc.
FASTREACT_MODEL=gpt-4o-mini

# API Key for the chosen provider
# For OpenAI: sk-xxx
# For Anthropic: sk-ant-xxx
# For DeepSeek: sk-xxx
FASTREACT_API_KEY=your-api-key-here

# Optional: Custom API base URL
# FASTREACT_API_BASE=https://api.openai.com/v1

# Optional: LLM parameters
FASTREACT_TEMPERATURE=0.7
FASTREACT_MAX_TOKENS=4096

# ==================================================
# Gateway Configuration (Optional)
# ==================================================
# Gateway HTTP/WebSocket port
GATEWAY_PORT=9000

# ==================================================
# Streamlit WebUI Configuration (Optional)
# ==================================================
# Streamlit port
WEBUI_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true

# ==================================================
# Feishu Bot Configuration (Optional)
# ==================================================
# Feishu App credentials (if using Feishu adapter)
# FEISHU_APP_ID=your-app-id
# FEISHU_APP_SECRET=your-app-secret
# FEISHU_ENCRYPT_KEY=your-encrypt-key
# FEISHU_VERIFICATION_TOKEN=your-verification-token

# Multi-tenant mode (recommended for production)
FEISHU_MULTITENANT=true
FEISHU_BASE_WORKSPACE=/workspace

# ==================================================
# Database Configuration (Optional - for production)
# ==================================================
# PostgreSQL database (if using external database)
# DB_HOST=postgres
# DB_PORT=5432
# DB_NAME=fastreact
# DB_USER=fastreact
# DB_PASSWORD=changeme

# ==================================================
# Security Configuration (Optional)
# ==================================================
# Maximum file size for uploads (bytes)
FASTREACT_MAX_FILE_SIZE=1048576

# Tool execution timeout (seconds)
FASTREACT_EXEC_TIMEOUT=30

# ==================================================
# Workspace Configuration (Optional)
# ==================================================
# Base workspace directory
FASTREACT_BASE_WORKSPACE=/workspace

# Config directory
FASTREACT_CONFIG_DIR=/app/.fastreact

# ==================================================
# Monitoring Configuration (Optional)
# ==================================================
# Grafana admin credentials
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=admin
