digraph G {
  rankdir=LR;
  node [shape=box, style=rounded];
  splines=ortho;

  subgraph cluster_foundation {
    label = "FOUNDATION";
    style = filled;
    color = white;
    "root" [label="root"];
    "__main__" [label="__main__"];
    "providers" [label="providers"];
  }

  subgraph cluster_core {
    label = "CORE";
    style = filled;
    color = lightgray;
    "core_react" [label="core.react"];
    "core" [label="core"];
  }

  subgraph cluster_skill {
    label = "SKILL";
    style = filled;
    color = lightpink;
    "skills" [label="skills"];
    "skills_loader" [label="skills.loader"];
  }

  subgraph cluster_tool {
    label = "TOOL";
    style = filled;
    color = lightyellow;
    "tools_edit_file" [label="tools.edit_file"];
    "tools" [label="tools"];
    "tools_exec_tool" [label="tools.exec_tool"];
    "tools_read_file" [label="tools.read_file"];
    "tools_write_file" [label="tools.write_file"];
    "mcp_manager" [label="mcp.manager"];
  }

  subgraph cluster_adapter {
    label = "ADAPTER";
    style = filled;
    color = lightgreen;
    "adapters_gateway" [label="adapters.gateway"];
    "adapters_web" [label="adapters.web"];
    "adapters_cli_enhanced" [label="adapters.cli_enhanced"];
    "adapters_repl" [label="adapters.repl"];
    "adapters_feishu_sdk" [label="adapters.feishu_sdk"];
    "adapters_cli" [label="adapters.cli"];
    "adapters_http" [label="adapters.http"];
    "adapters_feishu" [label="adapters.feishu"];
  }

  subgraph cluster_brain {
    label = "BRAIN";
    style = filled;
    color = lightblue;
    "agent" [label="agent"];
  }

  "root" -> "fastreact_providers_litellm";
  "root" -> "fastreact_tools";
  "root" -> "fastreact_core_safety";
  "root" -> "fastreact_mcp_manager";
  "root" -> "fastreact_core_events";
  "root" -> "fastreact_core_multitenant";
  "root" -> "fastreact_core_messages";
  "root" -> "fastreact_core_config";
  "root" -> "fastreact_agent";
  "root" -> "fastreact_core_context";
  "root" -> "fastreact_core_react";
  "root" -> "fastreact_core_tools";
  "root" -> "fastreact_skills";
  "agent" -> "fastreact_providers_litellm";
  "agent" -> "fastreact_tools";
  "agent" -> "fastreact_core_safety";
  "agent" -> "fastreact_mcp_manager";
  "agent" -> "fastreact_core_events";
  "agent" -> "fastreact_mcp_discovery";
  "agent" -> "fastreact_core_multitenant";
  "agent" -> "fastreact_core_prompts";
  "agent" -> "fastreact_core_messages";
  "agent" -> "fastreact_core_config";
  "agent" -> "fastreact_core_context";
  "agent" -> "fastreact_core_react";
  "agent" -> "fastreact_core_tools";
  "agent" -> "fastreact_skills";
  "__main__" -> "fastreact_adapters_http";
  "__main__" -> "fastreact_adapters_gateway";
  "tools_edit_file" -> "fastreact_core_tools";
  "tools" -> "fastreact_tools_edit_file";
  "tools" -> "fastreact_tools_exec_tool";
  "tools" -> "fastreact_tools_read_file";
  "tools" -> "fastreact_tools_write_file";
