{
  "_comment": "FastReAct Nano v2.1 配置文件示例",
  "_comment_2": "复制此文件为 config.json 或 ~/.fastreact/config.json",

  "llm": {
    "_comment": "方式1: 简化配置（推荐新手）",
    "model": "gpt-4o-mini",
    "api_base": null,
    "api_key": "sk-your-openai-api-key-here",
    "temperature": 0.7,
    "max_tokens": 8192,

    "_comment_alternative": "方式2: 使用 Anthropic Claude",
    "_example_anthropic": {
      "model": "claude-3-5-sonnet-20241022",
      "api_base": "https://api.anthropic.com",
      "api_key": "sk-ant-your-key-here"
    },

    "_comment_local": "方式3: 本地模型 (Ollama)",
    "_example_ollama": {
      "model": "ollama/llama3.2",
      "api_base": "http://localhost:11434/v1",
      "api_key": "dummy-key"
    },

    "_comment_v1_format": "方式4: v1多provider格式（兼容旧版）",
    "_example_v1": {
      "providers": {
        "openai": {
          "enabled": true,
          "model": "gpt-4o-mini",
          "base_url": "https://api.openai.com/v1",
          "api_key_env": "OPENAI_API_KEY",
          "temperature": 0.7,
          "max_tokens": 8192
        },
        "anthropic": {
          "enabled": false,
          "model": "claude-3-5-sonnet-20241022",
          "base_url": "https://api.anthropic.com",
          "api_key_env": "ANTHROPIC_API_KEY"
        },
        "siliconflow": {
          "enabled": false,
          "model": "deepseek-ai/DeepSeek-V3",
          "base_url": "https://api.siliconflow.cn/v1",
          "api_key_env": "SILICONFLOW_API_KEY"
        }
      },
      "default_provider": "openai"
    }
  },

  "tools": {
    "_comment": "文件操作限制",
    "max_file_size": 1048576,
    "protected_paths": [
      "/etc/passwd",
      "/etc/shadow",
      "C:\\Windows\\System32\\*"
    ],

    "_comment": "命令执行配置",
    "exec_timeout": 30,
    "working_dir": null
  },

  "react": {
    "_comment": "ReAct循环配置",
    "max_iterations": 128,
    "enable_steering": true,
    "enable_followup": true,
    "steering_file": ".steering.jsonl",

    "_comment": "上下文监控（Token Guard）",
    "max_context_tokens": 128000,
    "context_warning_threshold": 0.8,
    "max_tool_output_chars": 20000,

    "_comment": "文件系统记忆（Ghost Map）",
    "enable_filesystem_memory": true,
    "max_tree_depth": 3,
    "max_files_per_dir": 50,

    "_comment": "安全策略（Guardrails）",
    "enable_safety": true,
    "strict_mode": false,
    "auto_approve_safe": true
  },

  "service": {
    "_comment": "Headless HTTP/SSE daemon settings",
    "host": "0.0.0.0",
    "port": 18741,
    "log_level": "info",
    "service_token": null,
    "approval_timeout_seconds": 300,
    "run_lease_seconds": 300,
    "run_max_attempts": 3,
    "recover_queued_runs": true,
    "cors_origins": [
      "http://127.0.0.1:3000",
      "http://localhost:3000"
    ]
  },

  "web": {
    "_comment": "Local service console launched by ../start.sh",
    "enabled": true,
    "host": "127.0.0.1",
    "port": 3000
  },

  "logs": {
    "_comment": "Local logs used by ../start.sh",
    "http": "/tmp/fastreact-http.log",
    "web": "/tmp/fastreact-web.log"
  },

  "pska": {
    "_comment": "Optional PSKA linkage for ../start.sh. Keep refresh_config false when this file itself contains the PSKA MCP config.",
    "enabled": false,
    "archive": "/Users/xudawei/Documents/personal archive",
    "refresh_config": false,
    "config_file": null,
    "mcp_transport": "http"
  },

  "extensions": {
    "_comment": "Authenticated runtime reload is opt-in. Keep MCP reload disabled for PSKA/stateful integrations unless an operator explicitly wants reconnect semantics.",
    "runtime_reload_enabled": false,
    "mcp_reload_enabled": false
  },

  "mcp": {
    "_comment": "MCP (Model Context Protocol) 服务器配置",
    "_comment_2": "MCP 服务器可以与 Skill 关联，实现渐进式工具发现",
    "_comment_3": "https://modelcontextprotocol.io",
    "_comment_isolation": "多租户隔离模式配置 (multi-tenant deployments)",

    "servers": [
      {
        "_comment": "示例: 无状态工具 (全局共享模式)",
        "_comment_2": "适用场景: web_search, file_operations 等无状态工具",
        "name": "web_search",
        "command": "python3",
        "args": ["mcp_servers/web_search.py"],
        "isolation": "shared",
        "description": "Web search functionality"
      },
      {
        "_comment": "示例: 有状态工具 (每用户隔离模式)",
        "_comment_2": "适用场景: graphrag, database 等有状态工具",
        "_comment_3": "每用户拥有独立的 MCP 服务器进程",
        "name": "graphrag",
        "command": "python3",
        "args": ["mcp_servers/graphrag_server.py"],
        "isolation": "per_user",
        "per_user_args_template": ["--user-dir", "{user_workspace}"],
        "description": "GraphRAG knowledge graph operations"
      },
      {
        "_comment": "示例: 按需创建模式 (推荐)",
        "_comment_2": "适用场景: 平衡性能和隔离需求",
        "_comment_3": "活跃用户创建独立进程,空闲超时后自动回收",
        "name": "database",
        "command": "python3",
        "args": ["mcp_servers/database_server.py"],
        "isolation": "lazy_per_user",
        "per_user_args_template": ["--user-dir", "{user_workspace}"],
        "idle_timeout": 300,
        "max_instances": 10,
        "description": "User-specific database operations"
      },
      {
        "_comment": "示例: GitHub MCP 服务器 (默认 shared 模式)",
        "name": "github_mcp",
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-github"],
        "_comment_associated_skill": "可选: 关联的 Skill 名称",
        "associated_skill": null,
        "_comment_description": "可选: 服务器描述，用于工具发现",
        "description": "GitHub integration for repositories and PRs"
      },
      {
        "_comment": "示例: 文件系统 MCP 服务器",
        "name": "filesystem_mcp",
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-filesystem", "/allowed/path"],
        "associated_skill": "file_management",
        "description": "File system operations"
      },
      {
        "_comment": "示例: PostgreSQL MCP 服务器",
        "name": "postgres_mcp",
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-postgres", "postgresql://localhost/mydb"],
        "associated_skill": "database",
        "description": "PostgreSQL database operations"
      }
    ]
  }
}
