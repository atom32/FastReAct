# FastReAct Nano backend environment
#
# Copy to .env for local development, or export these variables in your
# process manager. Do not commit real keys.

# LLM provider
FASTRACT_MODEL=gpt-4o-mini
FASTRACT_API_BASE=
FASTRACT_API_KEY=
# OPENAI_API_KEY is also supported as a fallback.

# Runtime
FASTRACT_MAX_ITERATIONS=20
FASTRACT_MAX_TOOL_OUTPUT_CHARS=5000
FASTRACT_ENABLE_SAFETY=true
FASTRACT_AUTO_APPROVE_SAFE=true
FASTRICT_MODE=false

# Workspaces and JSONL control-plane store
FASTRACT_GATEWAY_WORKSPACE=./workspaces/default
FASTRACT_WORKING_DIR=./workspace
FASTRACT_SKILLS_DIR=./skills/builtin

# Gateway
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=9000
GATEWAY_LOG_LEVEL=info
GATEWAY_MULTITENANT=true
GATEWAY_ADMIN_KEY=change-this-admin-key

# Optional REST control-plane protection.
# When true, Admin HTTP APIs require X-Admin-Key: $GATEWAY_ADMIN_KEY.
FASTREACT_ADMIN_API_AUTH=false

# Comma-separated frontend origins allowed by CORS.
FASTREACT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AuthNode-backed inbound identity.
# Share AUTHNODE_JWT_SECRET with AuthNode and keep it out of source control.
FASTREACT_AUTH_MODE=jwt
FASTREACT_AUTH_JWT_SECRET_ENV=AUTHNODE_JWT_SECRET
FASTREACT_AUTH_JWT_ISSUER=authnode.local
FASTREACT_AUTH_JWT_AUDIENCE=fastreact
FASTREACT_AUTH_JWT_TENANT_CLAIMS=tenant_key,tenant_id,tenant,org_id

# MCP servers can be configured as a JSON array.
FASTRACT_MCP_SERVERS=[]
