# FastReAct Nano - Environment Configuration
#
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env (already in .gitignore, safe to use)
#    cp .env.example .env
#
# 2. Edit .env and add your API key
#    nano .env  #  or use your favorite editor
#
# 3. NEVER commit .env to git (it contains secrets!)
#
# ==================================================
# LLM Configuration (REQUIRED for testing)
# ==================================================
# Choose your LLM provider and update the values below

# Option 1: OpenAI (recommended for testing)
FASTRACT_MODEL=gpt-4o-mini
FASTRACT_API_BASE=https://api.openai.com/v1
FASTRACT_API_KEY=sk-your-openai-api-key-here

# Option 2: Anthropic Claude (uncomment to use)
# FASTRACT_MODEL=claude-3-5-sonnet-20241022
# FASTRACT_API_BASE=https://api.anthropic.com
# FASTRACT_API_KEY=sk-ant-your-anthropic-api-key-here

# Option 3: Azure OpenAI (uncomment to use)
# FASTRACT_MODEL=azure/gpt-4o-mini
# FASTRACT_API_BASE=https://your-resource.openai.azure.com
# FASTRACT_API_KEY=your-azure-api-key

# Optional: Adjust LLM parameters
FASTRACT_TEMPERATURE=0.7
FASTRACT_MAX_TOKENS=4096

# ==================================================
# Tool Configuration
# ==================================================
FASTRACT_MAX_FILE_SIZE=1048576
FASTRACT_EXEC_TIMEOUT=30
FASTRACT_WORKING_DIR=/workspace

# ==================================================
# Streamlit Web UI Configuration
# ==================================================
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true

# ==================================================
# Feishu Bot Configuration (Optional)
# ==================================================
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFICATION_TOKEN=
FEISHU_CONNECTION_MODE=sdk
FEISHU_HOST=0.0.0.0
FEISHU_PORT=8001
FEISHU_AUTO_RECONNECT=true

# ==================================================
# Multi-Tenant Configuration
# ==================================================
FEISHU_MULTITENANT=true
FEISHU_BASE_WORKSPACE=/workspace
FEISHU_WORKSPACE=/workspace

# ==================================================
# Monitoring Configuration (Optional)
# ==================================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
