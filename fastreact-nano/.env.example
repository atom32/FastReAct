# LLM Configuration
FASTRACT_MODEL=gpt-4o-mini
FASTRACT_API_KEY=sk-your-api-key-here
FASTRACT_API_BASE=https://api.openai.com/v1
FASTRACT_TEMPERATURE=0.7
FASTRACT_MAX_TOKENS=4096

# Tool Configuration
