{
  "llm": {
    "providers": {
      "siliconflow": {
        "enabled": true,
        "name": "SiliconFlow (DeepSeek)",
        "base_url": "https://api.siliconflow.cn/v1",
        "api_key": "YOUR_API_KEY_HERE",
        "model": "deepseek-ai/DeepSeek-V3",
        "max_tokens": 2048,
        "temperature": 0.7
      },
      "openai": {
        "enabled": false,
        "name": "OpenAI Official",
        "base_url": "https://api.openai.com/v1",
        "api_key": "YOUR_API_KEY_HERE",
        "model": "gpt-4",
        "max_tokens": 2048,
        "temperature": 0.7
      },
      "ollama": {
        "enabled": false,
        "name": "Local Ollama",
        "base_url": "http://localhost:11434/v1",
        "api_key": "ollama",
        "model": "llama3.1:8b",
        "max_tokens": 2048,
        "temperature": 0.7
      }
    },
    "default_provider": "siliconflow",
    "timeout_seconds": 60,
    "retry_attempts": 3
  },
  "react": {
    "max_iterations": 10,
    "max_concurrent_tools": 3,
    "enable_cache": true,
    "cache_size": 1000,
    "enable_streaming": false
  },
  "tools": {
    "builtin_enabled": true,
    "custom_tools_path": "tools/",
    "available_tools": [
      "Calculator",
      "Search",
      "Weather",
      "HTTP"
    ]
  },
  "logging": {
    "level": "INFO",
    "log_file": "logs/fastreact.log",
    "console_output": true
  }
}
